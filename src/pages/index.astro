>
  <Navbar />
  
  <main>
    <Hero />
    <Benefits />
    <Transformation />
    <Gallery />
    <Testimonials />
    <Pricing />
    <Location />
    <FinalCTA />
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
