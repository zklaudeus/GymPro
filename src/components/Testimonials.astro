---
const testimonials = [
  {
    name: "Carlos Rodríguez",
    role: "Socio desde hace 1 año",
    text: "Bajé 10 kilos y recuperé mi confianza. Los entrenadores realmente se preocupan por tus avances y el ambiente es inmejorable.",
    image: "https://i.pravatar.cc/150?img=11"
  },
  {
    name: "María Gómez",
    role: "Socia desde hace 6 meses",
    text: "Nunca me había gustado ir al gimnasio hasta que conocí GymPro. Las clases grupales son increíbles y la energía del lugar es muy motivadora.",
    image: "https://i.pravatar.cc/150?img=5"
  },
  {
    name: "Javier Morales",
    role: "Socio desde hace 2 años",
    text: "Las máquinas son de primer nivel. El asesoramiento personalizado me ayudó a superar mi estancamiento muscular. 100% recomendado.",
    image: "https://i.pravatar.cc/150?img=8"
  }
];
---

<section class="py-24 bg-dark-lighter">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-brand font-bold uppercase tracking-widest text-sm mb-2">Casos de Éxito</h2>
      <h3 class="text-3xl md:text-5xl font-heading font-black text-white mb-6">Lo que dicen nuestros alumnos</h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <div class="bg-dark p-8 rounded-2xl border border-dark-border relative">
          <!-- Quote Icon -->
          <svg class="absolute top-6 right-6 w-12 h-12 text-dark-border opacity-50" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          
          <!-- Stars -->
          <div class="flex text-brand mb-6">
            {'★★★★★'.split('').map(star => <span>{star}</span>)}
          </div>
          
          <p class="text-gray-300 italic mb-8 relative z-10">"{testimonial.text}"</p>
          
          <div class="flex items-center">
            <img src={testimonial.image} alt={testimonial.name} class="w-12 h-12 rounded-full border-2 border-brand" />
            <div class="ml-4">
              <h4 class="text-white font-bold">{testimonial.name}</h4>
              <p class="text-gray-500 text-sm">{testimonial.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
