<section class="py-24 bg-brand relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, black 1px, transparent 0); background-size: 24px 24px;"></div>
  
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <h2 class="text-4xl md:text-6xl font-heading font-black text-dark mb-6 leading-tight">
      Tu cambio empieza hoy
    </h2>
    <p class="text-dark/80 text-lg md:text-xl font-medium mb-10 max-w-2xl mx-auto">
      No esperes al próximo lunes o al próximo mes. Da el primer paso hoy mismo. Cupos limitados para entrenamiento personalizado.
    </p>
    
    <a 
      href="https://wa.me/1234567890?text=Hola,%20quiero%20empezar%20mi%20cambio%20hoy!" 
      target="_blank"
      class="inline-flex items-center justify-center bg-dark text-white px-10 py-5 rounded-full font-bold text-xl hover:scale-105 hover:bg-black transition-all shadow-xl group"
    >
      <svg class="w-8 h-8 mr-3 text-brand group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path fill-rule="evenodd" d="M12.031 21.085c-1.636 0-3.238-.426-4.664-1.233l-5.32 1.393 1.423-5.183c-.886-1.464-1.353-3.136-1.353-4.856 0-5.188 4.227-9.414 9.42-9.414 2.515 0 4.88 1.012 6.657 2.791A9.435 9.435 0 0121.45 11.205c0 5.188-4.226 9.414-9.42 9.414z" clip-rule="evenodd" />
      </svg>
      Reserva tu cupo ahora
    </a>
    
    <p class="mt-6 text-dark/70 font-semibold text-sm uppercase tracking-widest">
      * Consulta por tu primera clase de prueba gratis
    </p>
  </div>
</section>
