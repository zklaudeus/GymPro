---
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark-lighter py-12 border-t border-dark-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <a href="#" class="text-2xl font-heading font-black text-white uppercase tracking-tighter block mb-4">
          Gym<span class="text-brand">Pro</span>
        </a>
        <p class="text-gray-400 text-sm mb-4">
          Transforma tu cuerpo en 90 días. Entrena en un gimnasio moderno con los mejores profesionales.
        </p>
        <div class="flex space-x-4">
          <!-- Instagram -->
          <a href="#" class="text-gray-400 hover:text-brand transition-colors">
            <span class="sr-only">Instagram</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
            </svg>
          </a>
          <!-- Facebook -->
          <a href="#" class="text-gray-400 hover:text-brand transition-colors">
            <span class="sr-only">Facebook</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
            </svg>
          </a>
          <!-- TikTok -->
          <a href="#" class="text-gray-400 hover:text-brand transition-colors">
            <span class="sr-only">TikTok</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1.04-.1z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-bold mb-4 uppercase tracking-wider text-sm">Enlaces Rápidos</h3>
        <ul class="space-y-2">
          <li><a href="#beneficios" class="text-gray-400 hover:text-brand transition-colors text-sm">Beneficios</a></li>
          <li><a href="#resultados" class="text-gray-400 hover:text-brand transition-colors text-sm">Resultados</a></li>
          <li><a href="#planes" class="text-gray-400 hover:text-brand transition-colors text-sm">Planes</a></li>
          <li><a href="#ubicacion" class="text-gray-400 hover:text-brand transition-colors text-sm">Ubicación</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-bold mb-4 uppercase tracking-wider text-sm">Contacto</h3>
        <ul class="space-y-2 text-sm text-gray-400">
          <li class="flex items-start">
            <svg class="h-5 w-5 mr-2 text-brand flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Av. Principal 123,<br/>Ciudad de Ejemplo, 28001</span>
          </li>
          <li class="flex items-center mt-3">
            <svg class="h-5 w-5 mr-2 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="https://wa.me/1234567890" class="hover:text-white transition-colors">+34 123 456 789</a>
          </li>
        </ul>
      </div>

      <!-- Schedule -->
      <div>
        <h3 class="text-white font-bold mb-4 uppercase tracking-wider text-sm">Horarios</h3>
        <ul class="space-y-2 text-sm text-gray-400">
          <li class="flex justify-between border-b border-dark-border pb-1">
            <span>Lunes - Viernes</span>
            <span class="text-white font-medium">6:00 - 23:00</span>
          </li>
          <li class="flex justify-between border-b border-dark-border pb-1">
            <span>Sábados</span>
            <span class="text-white font-medium">8:00 - 20:00</span>
          </li>
          <li class="flex justify-between pb-1">
            <span>Domingos</span>
            <span class="text-white font-medium">9:00 - 14:00</span>
          </li>
        </ul>
      </div>

    </div>
    
    <div class="mt-12 pt-8 border-t border-dark-border text-center">
      <p class="text-gray-500 text-sm">
        &copy; {currentYear} GymPro. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
