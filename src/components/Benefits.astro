---
const benefits = [
  {
    icon: `<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
    title: "Máquinas Premium",
    description: "Equipamiento de última generación biomecánicamente diseñado para maximizar tus resultados sin lesiones."
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    title: "Entrenadores Certificados",
    description: "Profesionales capacitados que te guiarán paso a paso en tu proceso, adaptando el entrenamiento a tu nivel."
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    title: "Planes Accesibles",
    description: "La mejor relación calidad-precio. Invierte en tu salud sin pagar de más con nuestras opciones flexibles."
  }
];
---

<section id="beneficios" class="py-24 bg-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-brand font-bold uppercase tracking-widest text-sm mb-2">Por qué elegirnos</h2>
      <h3 class="text-3xl md:text-5xl font-heading font-black text-white mb-6">Todo lo que necesitas para tu éxito</h3>
      <p class="text-gray-400 text-lg">
        No somos solo un lugar con pesas. Somos un centro integral diseñado específicamente para garantizar tu transformación física y mental.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {benefits.map((benefit, index) => (
        <div class="bg-dark-lighter p-8 rounded-2xl border border-dark-border hover:border-brand/50 transition-colors group">
          <div class="w-16 h-16 rounded-xl bg-brand/10 text-brand flex items-center justify-center mb-6 group-hover:bg-brand group-hover:text-dark transition-colors">
            <Fragment set:html={benefit.icon} />
          </div>
          <h4 class="text-2xl font-heading font-bold text-white mb-4">{benefit.title}</h4>
          <p class="text-gray-400 leading-relaxed">
            {benefit.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
