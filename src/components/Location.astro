---
---

<section id="ubicacion" class="py-24 bg-dark-lighter">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <!-- Info -->
      <div>
        <h2 class="text-brand font-bold uppercase tracking-widest text-sm mb-2">Visítanos</h2>
        <h3 class="text-3xl md:text-5xl font-heading font-black text-white mb-6">Estamos cerca de ti</h3>
        <p class="text-gray-400 text-lg mb-8">
          Contamos con estacionamiento gratuito para clientes y acceso directo al transporte público. Ven a conocer nuestras instalaciones sin compromiso.
        </p>

        <div class="space-y-6">
          <div class="flex items-start">
            <div class="w-12 h-12 rounded-xl bg-dark border border-dark-border flex items-center justify-center text-brand flex-shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="ml-4">
              <h4 class="text-white font-bold text-lg mb-1">Dirección</h4>
              <p class="text-gray-400">Av. Principal 123, Centro de la Ciudad<br/>28001, Madrid</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="w-12 h-12 rounded-xl bg-dark border border-dark-border flex items-center justify-center text-brand flex-shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="ml-4">
              <h4 class="text-white font-bold text-lg mb-1">Horarios</h4>
              <p class="text-gray-400">Lunes a Viernes: 6:00 - 23:00<br/>Sábados y Domingos: 8:00 - 20:00</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="w-12 h-12 rounded-xl bg-dark border border-dark-border flex items-center justify-center text-brand flex-shrink-0">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <div class="ml-4">
              <h4 class="text-white font-bold text-lg mb-1">Estacionamiento</h4>
              <p class="text-gray-400">Gratis por 2 horas para clientes presentando ticket sellado.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Map Mockup (Using a generic iframe or styled div) -->
      <div class="h-96 bg-dark rounded-2xl border-2 border-dark-border overflow-hidden relative group">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d193595.15830869428!2d-74.119763973046!3d40.69766374874431!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNueva%20York%2C%20EE.%20UU.!5e0!3m2!1ses!2sve!4v1714524458564!5m2!1ses!2sve" 
          width="100%" 
          height="100%" 
          style="border:0; filter: invert(90%) hue-rotate(180deg);" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="transition-transform duration-500 group-hover:scale-105"
        ></iframe>
        <!-- Overlay to disable interactions if needed, or make map grayscale via CSS filter -->
        <div class="absolute inset-0 pointer-events-none shadow-[inset_0_0_20px_rgba(0,0,0,0.5)]"></div>
      </div>

    </div>
  </div>
</section>
